  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "temporal-polyfill": "1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  },
  "description": "Log time to your Clockify projects by asking your agent: a local stdio MCP server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/condensetech/clockify-mcp-server.git"
