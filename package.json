{
  "name": "@condensetech/clockify-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "lefthook install",
    "start": "bun src/index.ts",
    "test": "bun test",
